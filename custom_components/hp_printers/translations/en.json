{
  "config": {
    "step": {
      "user": {
        "title": "Add an HP printer",
        "description": "Enter the printer's address. Give it a name to control what its entities are called — leave it blank to use the model name.",
        "data": {
          "host": "Host or IP address",
          "name": "Name"
        },
        "data_description": {
          "host": "Prefer the printer's mDNS name, such as NPI2E7F3D.local, which survives address changes. An IP address works too.",
          "name": "Used for the device and all of its entity IDs. Short names work best."
        },
        "sections": {
          "advanced_settings": {
            "name": "Advanced settings",
            "data": {
              "port": "Port",
              "ssl": "Use HTTPS"
            },
            "data_description": {
              "port": "The embedded web server port. Leave at 80 and it will follow to 443 automatically if you turn on HTTPS.",
              "ssl": "Printers use a self-signed certificate, which is not verified."
            }
          }
        }
      },
      "reconfigure": {
        "title": "Reconfigure printer",
        "description": "Update how Home Assistant reaches this printer. It must still be the same physical device.",
        "data": {
          "host": "Host or IP address"
        },
        "sections": {
          "advanced_settings": {
            "name": "Advanced settings",
            "data": {
              "port": "Port",
              "ssl": "Use HTTPS"
            }
          }
        }
      },
      "zeroconf_confirm": {
        "title": "HP printer found",
        "description": "Found {model} at {host}. Give it a name to control what its entities are called, or leave it blank to use the model name.",
